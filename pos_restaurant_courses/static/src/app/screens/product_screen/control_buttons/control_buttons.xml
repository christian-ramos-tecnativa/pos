<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_restaurant_courses.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <!-- Add Course button -->
        <xpath expr="//button[hasclass('o_mobile_order_button')]" position="before">
            <button t-if="pos.config.module_pos_restaurant and pos.get_order() and !pos.get_order().isRefund"
                    class="btn btn-secondary btn-lg control-button course-button" 
                    t-on-click="()=>this.addCourse()">
                <i class="fa fa-cutlery"></i>
                <span>Course</span>
            </button>
        </xpath>
        
        <!-- Add Fire Course button -->
        <xpath expr="//button[hasclass('pay-order-button')]" position="before">
            <button t-if="this.displayFireCourseBtn"
                    class="btn btn-warning btn-lg control-button fire-course-button"
                    t-on-click="() => this.clickFireCourse()">
                <i class="fa fa-fire"></i>
                <span t-esc="this.fireCourseBtnText"></span>
            </button>
        </xpath>
    </t>
</templates>
