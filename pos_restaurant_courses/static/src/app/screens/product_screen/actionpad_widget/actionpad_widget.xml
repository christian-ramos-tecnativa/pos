<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_restaurant_courses.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <!-- Add Course button -->
        <xpath expr="//div[hasclass('actionpad')]//button[hasclass('mobile-more-button')]" position="before">
            <button t-if="pos.config.module_pos_restaurant and !this.currentOrder?.isRefund"
                    class="btn btn-secondary btn-lg flex-shrink-0 border-0" 
                    t-on-click="()=>this.addCourse()">
                <span>Course</span>
            </button>
        </xpath>
        
        <!-- Add Fire Course button before payment button -->
        <xpath expr="//div[hasclass('validation')]//button[hasclass('pay-order-button')]" position="before">
            <button t-if="this.displayFireCourseBtn"
                    class="fire-btn button btn btn-warning btn-lg d-flex align-items-center justify-content-center me-2"
                    t-on-click="() => this.clickFireCourse()">
                <span t-esc="this.fireCourseBtnText"></span>
            </button>
        </xpath>
    </t>
</templates>
